# ==============================================================================
# VISIONGPT ENVIRONMENT & DEPLOYMENT CONFIGURATION
# ==============================================================================

# --- ENVIRONMENT & SECURITY ---
ENVIRONMENT=development  # 'development', 'production', or 'testing'
DEBUG=false             # Set to true only during development
LOG_LEVEL=INFO          # 'DEBUG', 'INFO', 'WARNING', 'ERROR'
PROJECT_NAME=VisionGPT
API_V1_STR=/api/v1

# Security Origins (In production, specify comma-separated domains)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secret key for JWT generation (Generate using: openssl rand -hex 32)
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production_32bytes

# --- DATABASE CONFIGURATION ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_strong_password_change_me
POSTGRES_DB=visiongpt
POSTGRES_PORT=5432
POSTGRES_SERVER=localhost  # Use 'db' inside Docker Compose, 'localhost' for local dev

# Optional connection string override
# DATABASE_URL=postgresql://postgres:postgres_strong_password_change_me@localhost:5432/visiongpt

# --- UPLOAD & RESOURCE LIMITS ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100
ALLOWED_FILE_EXTENSIONS=.pdf,.txt,.md,.mp3,.wav,.m4a,.mp4,.mov,.avi,.webm,.jpg,.jpeg,.png,.webp

# --- CONCURRENCY & METRICS ---
MAX_CONCURRENT_JOBS=1     # Concurrency limit for heavy processing (1 for 4GB RAM safety)
METRICS_ENABLED=true      # Enable in-memory performance & observability metrics

# --- RAG ORCHESTRATION ---
RAG_PROVIDER=local        # 'local' (Ollama), 'cloud' (Gemini), or 'auto'

# --- AI RESOURCE PROFILES ---
# Options:
# 1. 'local'        -> 4GB RAM safe defaults (qwen2.5:3b, bge-small, Whisper small CPU)
# 2. 'high_quality' -> GPU deployment defaults (qwen2.5:14b, bge-large, Whisper large-v3 CUDA)
# 3. 'custom'       -> Uses explicit environment variable overrides below
VISIONGPT_PROFILE=local

# --- LOCAL OLLAMA CONFIGURATION ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- CLOUD GEMINI CONFIGURATION ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- CUSTOM MODEL OVERRIDES (Active when VISIONGPT_PROFILE=custom) ---
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIMENSION=384
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# FLORENCE_MODEL_ID=microsoft/Florence-2-base
# FLORENCE_DEVICE=cpu
# VIDEO_INTERVAL_SECONDS=3.0
# VIDEO_WINDOW_SIZE=15.0

# --- FRONTEND (NEXT.JS) CONFIGURATION ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
