# ==============================================================================
# VISIONGPT ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# --- DATABASE CONFIGURATION ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_strong_password_change_me
POSTGRES_DB=visiongpt
POSTGRES_PORT=5432
POSTGRES_SERVER=db  # Use 'db' for Docker Compose, 'localhost' for running backend locally outside Docker

# Database connection URL override (optional)
# DATABASE_URL=postgresql://postgres:postgres_strong_password_change_me@localhost:5432/visiongpt

# --- BACKEND (FASTAPI) CONFIGURATION ---
ENVIRONMENT=development
PROJECT_NAME=VisionGPT
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secret key for JWT generation (Generate using: openssl rand -hex 32)
JWT_SECRET_KEY=dev_secret_key_please_change_in_production_9876543210

# Storage config
UPLOAD_DIR=uploads

# --- FRONTEND (NEXT.JS) CONFIGURATION ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000

# Google Gemini API Key for vision model intelligence
GEMINI_API_KEY=your_gemini_api_key_here

